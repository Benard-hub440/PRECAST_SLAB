# Comma-separated public origins that may call the API. Leave empty when the
# dashboard and API are served from the same origin.
ALLOWED_ORIGINS=

# Comma-separated host names accepted by the deployed application.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Use a managed database in production; do not commit its credentials.
# DATABASE_URL=postgresql+psycopg://user:password@host/database

# Local Ollama (default): its base URL and any installed multimodal model.
VISION_PROVIDER=ollama
VISION_API_URL=http://127.0.0.1:11434
VISION_MODEL=your-local-multimodal-model

# Any OpenAI-compatible multimodal chat-completions endpoint.
# VISION_PROVIDER=openai_compatible
# VISION_API_URL=https://provider.example/v1/chat/completions
# VISION_API_KEY=replace-with-a-secret
# VISION_MODEL=provider-multimodal-model
